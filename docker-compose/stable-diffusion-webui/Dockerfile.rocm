# syntax=docker/dockerfile:1.4

# scikit-image==0.21.0 in stable-diffusion-webui's requirements_versions.txt publishes wheels only up to Python 3.11: https://pypi.org/project/scikit-image/0.21.0/#files
FROM python:3.11-slim-bookworm
LABEL org.opencontainers.image.source="https://github.com/hippocampus-dev/hippocampus"

RUN echo "nonroot:x:65532:65532::/home/nonroot:/usr/sbin/nologin" >> /etc/passwd
RUN echo "nonroot:x:65532:" >> /etc/group
RUN mkdir /home/nonroot && chown nonroot:nonroot /home/nonroot

RUN --mount=type=cache,target=/var/cache/apt/archives --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update -y && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends git sudo libgoogle-perftools-dev ffmpeg libglfw3-dev libgles2-mesa-dev pkg-config libcairo2 libcairo2-dev build-essential xdg-utils bc

RUN echo "nonroot:!:0:0:99999:7:::" >> /etc/shadow
RUN echo "%nonroot ALL=(ALL:ALL) NOPASSWD: ALL" | EDITOR="tee -a" visudo

# webui.sh must not be launched as root
USER 65532

WORKDIR /home/nonroot

# v1.10.1, the latest release, still clones Stability-AI/stablediffusion, which returns 404, and builds openai/CLIP against a setuptools without pkg_resources, both fixed only on the dev branch
RUN git init /home/nonroot/stable-diffusion-webui && \
    git -C /home/nonroot/stable-diffusion-webui fetch --depth 1 https://github.com/AUTOMATIC1111/stable-diffusion-webui 1937682a20f7f0442311a1ede68f9f0cb480163b && \
    git -C /home/nonroot/stable-diffusion-webui checkout FETCH_HEAD

COPY prepare.py /home/nonroot/stable-diffusion-webui/prepare.py

# ROCm 7.14 and 10.0 keep two HSA runtime threads per process busy-polling at idle in WSL: https://github.com/ROCm/rocm-systems/issues/15153#issuecomment-6668838584
# ROCm 10.1.0 is the first release carrying the fix: https://github.com/ROCm/rocm-systems/pull/7898
# ROCm 10.1.0 ships librocdxg, which lets HSA runtime reach the Windows driver over /dev/dxg in WSL, where /dev/kfd does not exist: https://rocm.docs.amd.com/en/docs-10.1.0/about/release-notes.html
# torch 2.13 and later require setuptools>=77.0.3, which conflicts with setuptools==69.5.1 in stable-diffusion-webui's requirements_versions.txt
# torchvision and torchaudio are the releases ROCm/pytorch release/2.12 pins: https://github.com/ROCm/pytorch/blob/release/2.12/related_commits
# The Radeon RX 9070 XT of hyperv-host is gfx1201: https://github.com/ROCm/TheRock/blob/main/RELEASES.md
# webui.sh reuses an existing venv, where prepare_environment finds torch and skips TORCH_COMMAND
RUN python -m venv /home/nonroot/stable-diffusion-webui/venv && \
    /home/nonroot/stable-diffusion-webui/venv/bin/pip install --no-cache-dir --index-url https://stable.repo.amd.com/rocm/whl-next/ "torch[device-gfx1201]==2.12.0+rocm10.1.0" "torchvision[device-gfx1201]==0.27.0+rocm10.1.0" torchaudio==2.11.0+rocm10.1.0 && \
    /home/nonroot/stable-diffusion-webui/venv/bin/pip freeze | grep -E "^(torch|torchvision|torchaudio)==" > /home/nonroot/constraints.txt
# Keeps an extension's requirements from pulling the CUDA build of torch from PyPI over the ROCm one
ENV PIP_CONSTRAINT=/home/nonroot/constraints.txt

# xformers ships CUDA kernels only, so attention falls back to PyTorch's SDPA
# webui.sh exits 0 even when prepare.py raises, so the import of gradio from requirements_versions.txt is what fails the build
RUN LAUNCH_SCRIPT=/home/nonroot/stable-diffusion-webui/prepare.py bash /home/nonroot/stable-diffusion-webui/webui.sh --skip-torch-cuda-test && \
    /home/nonroot/stable-diffusion-webui/venv/bin/python -c "import gradio, torch; assert torch.version.hip, torch.__version__"

RUN git clone https://github.com/wcde/sd-webui-refiner.git --depth 1 /home/nonroot/stable-diffusion-webui/extensions/sd-webui-refiner
RUN git clone https://github.com/Mikubill/sd-webui-controlnet.git --depth 1 /home/nonroot/stable-diffusion-webui/extensions/sd-webui-controlnet
RUN git clone https://github.com/Zyin055/Config-Presets --depth 1 /home/nonroot/stable-diffusion-webui/extensions/Config-Presets
RUN git clone https://github.com/DominikDoom/a1111-sd-webui-tagcomplete --depth 1 /home/nonroot/stable-diffusion-webui/extensions/a1111-sd-webui-tagcomplete

ENTRYPOINT ["bash", "/home/nonroot/stable-diffusion-webui/webui.sh", "--skip-prepare-environment"]
CMD ["--allow-code", "--medvram", "--enable-insecure-extension-access", "--api", "--listen"]
