#!/usr/bin/env bash

set -Eeo pipefail
trap 'echo "exit $?: $BASH_COMMAND(line $LINENO)" >&2' ERR

readonly FRAMERATE=30
readonly SHUTDOWN_SECONDS=10
readonly POLL_SECONDS=0.1

readonly STATE_FILE="${XDG_RUNTIME_DIR:-/tmp}/screenrecord"

if [ -f "$STATE_FILE" ]; then
  read -r pid output < "$STATE_FILE" || true
  rm -f "$STATE_FILE"
  if [ "$(cat "/proc/${pid}/comm" 2>/dev/null)" != "ffmpeg" ]; then
    echo "The recording to $output already ended - press again to start a new one" 1>&2
    notify-send "Screenrecord" "Lost $output"
    exit 1
  fi
  kill -INT "$pid"
  deadline=$(($(date +%s) + SHUTDOWN_SECONDS))
  while [ "$(date +%s)" -lt "$deadline" ] && kill -0 "$pid" 2>/dev/null; do
    sleep "$POLL_SECONDS"
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -KILL "$pid"
    notify-send "Screenrecord" "Aborted $output"
  else
    notify-send "Screenrecord" "file://${output}"$'\n\n'"Saved"
  fi
  exit 0
fi

sink=$(pactl get-default-sink)
readonly VIDEOS_DIRECTORY="${XDG_VIDEOS_DIR:-${HOME}/Videos}"
output="${VIDEOS_DIRECTORY}/$(date +%Y%m%d%H%M%S).mp4"

mkdir -p "$VIDEOS_DIRECTORY"
ffmpeg -nostdin -loglevel error -f x11grab -select_region 1 -framerate "$FRAMERATE" -i "$DISPLAY" -f pulse -i "${sink}.monitor" -c:v h264_nvenc -pix_fmt yuv420p -c:a aac "$output" &
echo "$! $output" > "$STATE_FILE"
notify-send "Screenrecord" "Recording to $output"
