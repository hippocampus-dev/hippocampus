<?xml version="1.0" encoding="UTF-8"?>

<openbox_menu xmlns="http://openbox.org/3.4/menu">

    <menu id="hyperv-host-menu" label="hyperv-host">
        <item label="Start">
            <action name="Execute">
                <prompt>yes</prompt>
                <command>systemd-run --user --collect --unit=hyperv-host-start sh -c '/usr/local/bin/minikube-wake-worker.sh hyperv-worker &amp;&amp; notify-send "hyperv-host" "Sent Wake-on-LAN"'</command>
            </action>
        </item>
        <item label="On">
            <action name="Execute">
                <prompt>yes</prompt>
                <command>systemd-run --user --collect --unit=hyperv-host-on sh -c '/usr/local/bin/hyperv-host.sh on hyperv-worker &amp;&amp; notify-send "hyperv-host" "Turned on"'</command>
            </action>
        </item>
        <item label="Off">
            <action name="Execute">
                <prompt>yes</prompt>
                <command>systemd-run --user --collect --unit=hyperv-host-off sh -c '/usr/local/bin/hyperv-host.sh off hyperv-worker &amp;&amp; notify-send "hyperv-host" "Turned off"'</command>
            </action>
        </item>
        <item label="Start VM">
            <action name="Execute">
                <prompt>yes</prompt>
                <command>systemd-run --user --collect --unit=hyperv-host-start-vm sh -c '/usr/local/bin/hyperv-host.sh start hyperv-worker &amp;&amp; notify-send "hyperv-host" "Started"'</command>
            </action>
        </item>
        <item label="Stop VM">
            <action name="Execute">
                <prompt>yes</prompt>
                <command>systemd-run --user --collect --unit=hyperv-host-stop-vm sh -c '/usr/local/bin/hyperv-host.sh stop hyperv-worker &amp;&amp; notify-send "hyperv-host" "Stopped"'</command>
            </action>
        </item>
        <item label="Shutdown">
            <action name="Execute">
                <prompt>yes</prompt>
                <command>systemd-run --user --collect --unit=hyperv-host-shutdown sh -c '/usr/local/bin/hyperv-host.sh shutdown hyperv-worker &amp;&amp; notify-send "hyperv-host" "Shut down"'</command>
            </action>
        </item>
    </menu>

    <menu id="root-menu" label="Openbox 3">
        <separator label="Development" />
        <item label="Google Chrome">
            <action name="Execute">
                <command>/usr/bin/google-chrome-stable --remote-debugging-port=59222 --user-data-dir=/var/google-chrome</command>
                <startupnotify>
                    <enabled>yes</enabled>
                </startupnotify>
            </action>
        </item>
        <item label="IntelliJ">
            <action name="Execute">
                <command>systemd-run --user --scope --collect --property=MemorySwapMax=0 /usr/bin/intellij-idea-ultimate-edition</command>
                <startupnotify>
                    <enabled>yes</enabled>
                </startupnotify>
            </action>
        </item>
        <item label="Android Studio">
            <action name="Execute">
                <command>/usr/bin/android-studio</command>
                <startupnotify>
                    <enabled>yes</enabled>
                </startupnotify>
            </action>
        </item>
        <item label="xterm">
            <action name="Execute">
                <command>/usr/bin/xterm</command>
                <startupnotify>
                    <enabled>yes</enabled>
                </startupnotify>
            </action>
        </item>
        <item label="ChatGPT">
            <action name="Execute">
                <command>/usr/bin/chatgpt</command>
                <startupnotify>
                    <enabled>yes</enabled>
                </startupnotify>
            </action>
        </item>
        <item label="Virt Manager">
            <action name="Execute">
                <command>/usr/bin/virt-manager</command>
                <startupnotify>
                    <enabled>yes</enabled>
                </startupnotify>
            </action>
        </item>
        <item label="Wireshark">
            <action name="Execute">
                <command>/usr/bin/wireshark</command>
                <startupnotify>
                    <enabled>yes</enabled>
                </startupnotify>
            </action>
        </item>
        <separator label="Media" />
        <item label="Steam">
            <action name="Execute">
                <command>/usr/bin/steam</command>
                <startupnotify>
                    <enabled>yes</enabled>
                </startupnotify>
            </action>
        </item>
        <item label="Moonlight">
            <action name="Execute">
                <command>/usr/bin/moonlight</command>
                <startupnotify>
                    <enabled>yes</enabled>
                </startupnotify>
            </action>
        </item>
        <item label="Celluloid">
            <action name="Execute">
                <command>/usr/bin/celluloid</command>
                <startupnotify>
                    <enabled>yes</enabled>
                </startupnotify>
            </action>
        </item>
        <item label="MuseScore">
            <action name="Execute">
                <command>/usr/bin/mscore</command>
                <startupnotify>
                    <enabled>yes</enabled>
                </startupnotify>
            </action>
        </item>
        <separator label="Settings" />
        <item label="PulseAudio Volume Control">
            <action name="Execute">
                <command>/usr/bin/pavucontrol</command>
                <startupnotify>
                    <enabled>yes</enabled>
                </startupnotify>
            </action>
        </item>
        <item label="Easy Effects">
            <action name="Execute">
                <command>/usr/bin/easyeffects</command>
                <startupnotify>
                    <enabled>yes</enabled>
                </startupnotify>
            </action>
        </item>
        <item label="Keymapp">
            <action name="Execute">
                <command>/usr/bin/keymapp</command>
                <startupnotify>
                    <enabled>yes</enabled>
                </startupnotify>
            </action>
        </item>
        <item label="Piper">
            <action name="Execute">
                <command>/usr/bin/piper</command>
                <startupnotify>
                    <enabled>yes</enabled>
                </startupnotify>
            </action>
        </item>
        <separator />
        <item label="Screen Off">
            <action name="Execute">
                <command>xset dpms force off</command>
            </action>
        </item>
        <item label="Log Out">
            <action name="Exit">
                <prompt>yes</prompt>
            </action>
        </item>
        <item label="Suspend">
            <action name="Execute">
                <prompt>yes</prompt>
                <command>systemctl hybrid-sleep</command>
            </action>
        </item>
        <item label="Reboot">
            <action name="Execute">
                <prompt>yes</prompt>
                <command>systemctl reboot</command>
            </action>
        </item>
        <item label="Reboot Into Windows">
            <action name="Execute">
                <prompt>yes</prompt>
                <command>systemctl reboot --boot-loader-entry=auto-windows</command>
            </action>
        </item>
        <item label="Reboot Into Firmware">
            <action name="Execute">
                <prompt>yes</prompt>
                <command>systemctl reboot --boot-loader-entry=auto-reboot-to-firmware-setup</command>
            </action>
        </item>
        <item label="Poweroff">
            <action name="Execute">
                <prompt>yes</prompt>
                <command>systemctl poweroff</command>
            </action>
        </item>
        <item label="Poweroff With hyperv-host">
            <action name="Execute">
                <prompt>yes</prompt>
                <command>systemd-run --user --collect --unit=hyperv-host-poweroff sh -c '/usr/local/bin/hyperv-host.sh shutdown hyperv-worker &amp;&amp; systemctl poweroff'</command>
            </action>
        </item>
        <separator label="Machines" />
        <menu id="hyperv-host-menu" />
    </menu>

</openbox_menu>
