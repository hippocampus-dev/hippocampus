{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 3650,
  "env": {
    "DISABLE_MICROCOMPACT": "true",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_TRACES_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "https://opentelemetry-collector.127.0.0.1.nip.io",
    "OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE": "cumulative",
    "NODE_EXTRA_CA_CERTS": "/home/kai/.local/share/mkcert/rootCA.pem"
  },
  "permissions": {
    "allow": [
      "Task",
      "Glob",
      "Grep",
      "LS",
      "Read",
      "Edit",
      "MultiEdit",
      "Write",
      "TodoRead",
      "TodoWrite",
      "WebSearch",
      "WebFetch",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(make:*)",
      "Bash(mkdir:*)",
      "Bash(chmod:*)",
      "Bash(cargo:*)",
      "Bash(go:*)",
      "Bash(uv:*)",
      "Bash(npm:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "mcp__notify__notify",
      "mcp__agy__agy",
      "mcp__codex__codex"
    ],
    "deny": []
  },
  "model": "opus[1m]",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claudex/config/hooks/UserPromptSubmit.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claudex/config/hooks/PreToolUse.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claudex/config/hooks/PostToolUse.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claudex/config/hooks/Notification.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claudex/config/hooks/Stop.sh"
          }
        ]
      }
    ],
    "SubagentStop": [],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/claudex/config/hooks/SessionEnd.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.config/claudex/config/hooks/statusLine.sh"
  },
  "sandbox": {
    "enabled": false,
    "network": {
      "allowedDomains": [
        "*.127.0.0.1.nip.io",
        "*.kaidotio.dev",
        "localhost",
        "127.0.0.1",
        "api.github.com",
        "api.openai.com",
        "raw.githubusercontent.com"
      ]
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 2069451551000
  }
}
