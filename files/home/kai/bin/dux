#!/usr/bin/env bash

set -Eeo pipefail
trap 'echo "exit $?: $BASH_COMMAND(line $LINENO)" >&2' ERR

usage() {
  cat <<EOS
Usage:
   dux [--max-depth DEPTH]
EOS
}

args=()
flags=()
max_depth=0
while (( $# )); do
  case "$1" in
    --max-depth)
      max_depth="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*|--*)
      echo "Unsupported flag $1" 1>&2
      exit 1
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

total=$(du -sb "${args[@]}" | cut -f1)
entries=$(du -ab --max-depth="$max_depth" "${args[@]}" 2>/dev/null)

while IFS=$'\t' read -r size path; do
  percent=$((size * 100 / total))
  if [ "$size" -ge 1073741824 ]; then
    formatted_size=$((size / 1073741824)).$((size % 1073741824 * 10 / 1073741824))G
  elif [ "$size" -ge 1048576 ]; then
    formatted_size=$((size / 1048576)).$((size % 1048576 * 10 / 1048576))M
  else
    formatted_size=$((size / 1024)).$((size % 1024 * 10 / 1024))K
  fi
  printf "%s\t%d%%\t%s\n" "$formatted_size" "$percent" "$path"
done <<< "$entries" | sort -t$'\t' -k1 -h -r | column -t
