# ATTR{index}=="2" is this webcam's second VideoStreaming interface, the 352x352 infrared stream applications list beside the color node under the same name
# The number has to sort between 70-uaccess.rules, which adds the tag, and 73-seat-late.rules, which turns it into an ACL for the seat's user
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="413c", ATTRS{idProduct}=="c024", ATTR{index}=="2", TAG-="uaccess", MODE="0600"
