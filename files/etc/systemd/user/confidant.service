[Unit]

[Service]
Restart=always
RestartSec=5

# /etc/xrdp/startwm.sh sources ~/.xinitrc, whose /etc/X11/xinit/xinitrc.d/50-systemd-user.sh imports the xrdp session's DISPLAY into the user manager
Environment=DISPLAY=:0
# evdev KEY_TAB (15) and KEY_F13 (183) plus the X11 keycode offset of 8, F13 on layer 1 of moonlander/keymap.c
ExecStart=%h/.asdf/shims/confidant --switch-key 23 --linear --confine-key 191 --confine-modifier control

[Install]
WantedBy=default.target
