[Unit]
Requires=network-online.target
Wants=docker.service docker-rootless.service
After=network-online.target docker.service docker-rootless.service

[Service]
Type=oneshot
RemainAfterExit=yes

User=kai
ExecStart=/usr/local/bin/startup.sh
ExecStop=/usr/local/bin/shutdown.sh
TimeoutStopSec=1800

[Install]
WantedBy=multi-user.target
