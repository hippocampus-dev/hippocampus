[Unit]
# A minikube-gce-worker.service start during minikube.service's stop job cancels it with "Job for minikube.service canceled.": https://www.freedesktop.org/software/systemd/man/latest/systemd.unit.html#PartOf=
PartOf=minikube.service

[Timer]
OnCalendar=*:*:0/15
# Defaults to 1min, which would let every elapse slip past the next 15s slot: https://www.freedesktop.org/software/systemd/man/latest/systemd.timer.html#AccuracySec=
AccuracySec=1s
Persistent=true

[Install]
WantedBy=timers.target
