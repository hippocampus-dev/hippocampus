+	get_fuse_inode(inode)->bpf_ops =3D dir_fuse_inode->bpf_ops;
+	if (get_fuse_inode(inode)->bpf_ops)
+		if (!get_fuse_ops(get_fuse_inode(inode)->bpf_ops)) {
+			*out =3D -EINVAL;
+			goto out;
+		}
