+	int status;
+	DIR *dir =3D NULL;
+	struct dirent *dirent;
+
+	TEST(src_fd =3D open(ft_src, O_DIRECTORY | O_RDONLY | O_CLOEXEC),
+	     src_fd !=3D -1);
+	TESTEQUAL(create_file(src_fd, s(names[0]), 1, 2), 0);
+	TESTEQUAL(create_file(src_fd, s(names[1]), 1, 2), 0);
+	TEST(test_skel =3D test_bpf__open_and_load(), test_skel !=3D NULL);
+	TEST(test_link =3D bpf_map__attach_struct_ops(test_skel->maps.test_trace_=
ops), test_link !=3D NULL);
+	TESTEQUAL(mount_fuse(mount_dir, "test_trace_ops", src_fd, &fuse_dev), 0);
+
+	FUSE_ACTION
+		int i, j;
+
+		TEST(dir =3D s_opendir(s(mount_dir)), dir);
+		TESTEQUAL(bpf_test_trace("opendir"), 0);
+
+		for (i =3D 0; i < ARRAY_SIZE(names); ++i) {
+			TEST(dirent =3D readdir(dir), dirent);
+
+			for (j =3D 0; j < ARRAY_SIZE(names); ++j)
+				if (names[j] &&
+				    strcmp(names[j], dirent->d_name) =3D=3D 0) {
+					names[j] =3D NULL;
+					break;
+				}
+			TESTNE(j, ARRAY_SIZE(names));
+		}
+		TEST(dirent =3D readdir(dir), dirent =3D=3D NULL);
+		TESTSYSCALL(closedir(dir));
+		dir =3D NULL;
+		TESTEQUAL(bpf_test_trace("readdir"), 0);
+	FUSE_DAEMON
+		struct fuse_in_header *in_header =3D
+			(struct fuse_in_header *)bytes_in;
+		ssize_t res =3D read(fuse_dev, bytes_in, sizeof(bytes_in));
+		// ignore the error in extension
+		res -=3D ERR_IN_EXT_LEN;
+		struct fuse_read_out *read_out =3D
+			(struct fuse_read_out *) (bytes_in +
