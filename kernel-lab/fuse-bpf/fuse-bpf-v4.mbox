+		.size =3D 0,
+		.alloc_size =3D sizeof(args->entries_storage.out),
+		.max_size =3D sizeof(args->entries_storage.out),
+		.flags =3D BPF_FUSE_VARIABLE_SIZE,
+	},
+
+	fa->out_numargs =3D 2;
+	fa->flags =3D FUSE_BPF_OUT_ARGVAR | FUSE_BPF_IS_LOOKUP;
+	fa->out_args[0] =3D (struct bpf_fuse_arg) {
+		.size =3D sizeof(args->out),
