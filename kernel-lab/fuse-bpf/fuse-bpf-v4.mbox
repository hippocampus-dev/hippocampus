+static inline void print_bytes(const void *data, size_t size)
+{
+	const char *bytes =3D data;
+	int i;
+
+	for (i =3D 0; i < size; ++i) {
+		if (i % 0x10 =3D=3D 0)
+			printf("%08x:", i);
+		printf("%02x ", (unsigned int) (unsigned char) bytes[i]);
+		if (i % 0x10 =3D=3D 0x0f)
+			printf("\n");
+	}
+
+	if (i % 0x10 !=3D 0)
+		printf("\n");
+}
