+static inline int fuse_bpf_fsync(int *out, struct inode *inode, struct fil=
e *file, loff_t start, loff_t end, int datasync)
+{
+	return 0;
+}
+
+static inline int fuse_bpf_dir_fsync(int *out, struct inode *inode, struct=
 file *file, loff_t start, loff_t end, int datasync)
