+static void fuse_stat_to_attr(struct fuse_conn *fc, struct inode *inode,
+			      struct kstat *stat, struct fuse_attr *attr)
+{
+	unsigned int blkbits;
+
+	/* see the comment in fuse_change_attributes() */
+	if (fc->writeback_cache && S_ISREG(inode->i_mode)) {
+		struct timespec64 mtime =3D inode_get_mtime(inode);
+		struct timespec64 ctime =3D inode_get_ctime(inode);
+
+		stat->size =3D i_size_read(inode);
+		stat->mtime.tv_sec =3D mtime.tv_sec;
+		stat->mtime.tv_nsec =3D mtime.tv_nsec;
+		stat->ctime.tv_sec =3D ctime.tv_sec;
+		stat->ctime.tv_nsec =3D ctime.tv_nsec;
+	}
+
+	attr->ino =3D stat->ino;
+	attr->mode =3D (inode->i_mode & S_IFMT) | (stat->mode & 07777);
+	attr->nlink =3D stat->nlink;
+	attr->uid =3D from_kuid(fc->user_ns, stat->uid);
+	attr->gid =3D from_kgid(fc->user_ns, stat->gid);
+	attr->atime =3D stat->atime.tv_sec;
+	attr->atimensec =3D stat->atime.tv_nsec;
+	attr->mtime =3D stat->mtime.tv_sec;
+	attr->mtimensec =3D stat->mtime.tv_nsec;
+	attr->ctime =3D stat->ctime.tv_sec;
+	attr->ctimensec =3D stat->ctime.tv_nsec;
+	attr->size =3D stat->size;
+	attr->blocks =3D stat->blocks;
+
+	if (stat->blksize !=3D 0)
+		blkbits =3D ilog2(stat->blksize);
+	else
+		blkbits =3D inode->i_sb->s_blocksize_bits;
+
+	attr->blksize =3D 1 << blkbits;
+}
