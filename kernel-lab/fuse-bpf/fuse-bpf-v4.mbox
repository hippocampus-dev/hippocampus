+	struct bpf_link *test_link =3D NULL;
+	const char *names[] =3D {"real", "partial", "fake", ".", ".."};
+	int result =3D TEST_FAILURE;
+	int src_fd =3D -1;
+	int fuse_dev =3D -1;
