Add a default bpf func to call if the specific one is not present.
Useful if you wish to track when different ops are handled.

Signed-off-by: Daniel Rosenberg <drosen@google.com>
---
 fs/fuse/backing.c        | 136 +++++++++++++++++++++------------------
 include/linux/bpf_fuse.h |   2 +
 include/uapi/linux/bpf.h |   1 +
 3 files changed, 77 insertions(+), 62 deletions(-)

diff --git a/fs/fuse/backing.c b/fs/fuse/backing.c
index 9227e62b8734..ec554a2bc93f 100644
--- a/fs/fuse/backing.c
+++ b/fs/fuse/backing.c
@@ -244,6 +244,12 @@ static inline void bpf_fuse_free_alloced(struct bpf_fu=
se_args *fa)
 						&fa.info, &feo);	\
 		else							\
 			bpf_next =3D BPF_FUSE_CONTINUE;			\
+		if (bpf_next =3D=3D BPF_FUSE_CALL_DEFAULT) {		\
+			if (fuse_ops->default_filter)			\
+				bpf_next =3D fuse_ops->default_filter(&fa.info); \
+			else						\
+				bpf_next =3D BPF_FUSE_CONTINUE;		\
+		}							\
 		if (bpf_next < 0) {					\
 			error =3D bpf_next;				\
 			break;						\
@@ -283,6 +289,12 @@ static inline void bpf_fuse_free_alloced(struct bpf_fu=
se_args *fa)
 		fa.info.opcode |=3D FUSE_POSTFILTER;			\
 		if (bpf_next =3D=3D BPF_FUSE_POSTFILTER)			\
 			bpf_next =3D call_postfilter(fuse_ops, &fa.info, &feo);\
+		if (bpf_next =3D=3D BPF_FUSE_CALL_DEFAULT) {		\
+			if (fuse_ops->default_filter)			\
+				bpf_next =3D fuse_ops->default_filter(&fa.info); \
+			else						\
+				bpf_next =3D BPF_FUSE_CONTINUE;		\
+		}							\
 		if (bpf_next < 0) {					\
 			error =3D bpf_next;				\
 			break;						\
@@ -611,7 +623,7 @@ static int fuse_open_prefilter(struct fuse_ops *ops, st=
ruct bpf_fuse_meta_info *
 		if (ops->opendir_prefilter)
 			return ops->opendir_prefilter(meta, &open->in);
 	}
-	return BPF_FUSE_CONTINUE;
+	return BPF_FUSE_CALL_DEFAULT;
