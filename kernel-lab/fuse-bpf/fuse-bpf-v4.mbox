le, int mode, loff_t offset, loff_t length);
@@ -1498,11 +1501,26 @@ static inline int fuse_bpf_releasedir(int *out, str=
uct inode *inode, struct file
 	return 0;
 }
=20
+static inline int fuse_bpf_flush(int *out, struct inode *inode, struct fil=
e *file, fl_owner_t id)
+{
+	return 0;
+}
+
 static inline int fuse_bpf_lseek(loff_t *out, struct inode *inode, struct =
file *file, loff_t offset, int whence)
 {
 	return 0;
 }
