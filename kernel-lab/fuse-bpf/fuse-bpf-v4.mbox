@@ -1024,6 +1024,7 @@ bool bpf_struct_ops_get(const void *kdata)
 	map =3D __bpf_map_inc_not_zero(&st_map->map, false);
 	return !IS_ERR(map);
 }
+EXPORT_SYMBOL_GPL(bpf_struct_ops_get);
=20
 void bpf_struct_ops_put(const void *kdata)
 {
