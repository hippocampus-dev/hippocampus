+
+	TEST(src_fd =3D open("fd-src", O_DIRECTORY | O_RDONLY | O_CLOEXEC),
+	     src_fd !=3D -1);
+	TESTSYSCALL(mkdirat(src_fd, "show", 0777));
+	TESTSYSCALL(mkdirat(src_fd, "hide", 0777));
+
+	/*for (i =3D 0; i < map_count; ++i)
+		if (!strcmp(map_relocations[i].name, "test_map")) {
+			uint32_t key =3D 23;
